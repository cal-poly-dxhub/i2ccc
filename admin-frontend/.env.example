# Local development only (pnpm dev, port 5174). Deployed builds get these from
# the CDK stack outputs via scripts/deploy-admin-frontend.sh.
# Redirect/logout URIs must match a callback URL on the Cognito app client
# (http://localhost:5174 is registered in dev mode only).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:5174
VITE_COGNITO_LOGOUT_URI=http://localhost:5174
# Leave empty on dev stacks (no SAML provider)
VITE_COGNITO_IDP_NAME=
